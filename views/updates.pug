doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")

  body
    a(href="/") Return to the homepage

    h1= title

    form(action="/update-cobj" method="POST")
      label(for="name") Name
      input#name(type="text" name="name" required)

      label(for="author") Author
      input#author(type="text" name="author" required)

      label(for="pages") Pages
      input#pages(type="number" name="pages" required)

      button(type="submit") Add Book