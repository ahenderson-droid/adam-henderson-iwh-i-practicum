doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")

  body
    h1 Books

    a(href="/update-cobj") Add to this table

    table
      thead
        tr
          th Name
          th Author
          th Pages

      tbody
        each record in data
          tr
            td= record.properties.name
            td= record.properties.author
            td= record.properties.pages